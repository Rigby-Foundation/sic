# sic system call table: the sic ABI, independent of Linux numbering.
#
# Format: <number> <name>. Generated into sic/include/abi/syscall_nr.h (kernel)
# and libc's bits/syscall.h (musl) by abi/gen.py. Names follow the POSIX/musl
# vocabulary so musl needs no source changes beyond the numbers themselves.
# Numbers 0-255 are grouped by subsystem; 512+ are names musl references but
# sic does not implement (the kernel answers ENOSYS). Never renumber.

# process
0    exit
1    exit_group
2    fork
3    vfork
4    clone
5    execve
6    wait4
7    waitid
8    getpid
9    getppid
10   gettid
11   sched_yield
12   kill
13   tkill
14   tgkill
15   set_tid_address
16   set_robust_list
