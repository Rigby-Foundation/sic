# sic default configuration. `make defconfig` copies this to .config;
# without a .config the build uses this file directly.
# edit .config (or pass CONFIG_FOO=n on the make command line) to change
# what gets built. Each option is CONFIG_<NAME>=y or =n.

# --- processors -------------------------------------------------------------
CONFIG_SMP=y            # start the application processors listed in the MADT

# --- console ----------------------------------------------------------------
CONFIG_FB_CONSOLE=y     # text console on the framebuffer
CONFIG_SERIAL=y         # COM1 output (and the only console if FB_CONSOLE=n)
CONFIG_KEYBOARD=y       # PS/2 keyboard -> /dev/console input
CONFIG_MOUSE=y          # PS/2 mouse -> /dev/mouse
CONFIG_VIRTIO_GPU=y        # virtio-gpu display (QEMU -vga virtio); needs PCI and FB_CONSOLE
CONFIG_VIRTIO_INPUT=n      # virtio-keyboard-pci / virtio-mouse-pci (input comes from PS/2 / serial here)

# --- buses & storage --------------------------------------------------------
CONFIG_PCI=y            # PCI enumeration (needed by every PCI driver below)
CONFIG_NVME=y           # NVMe controllers -> /dev/nvmeXnY  (needs PCI)
CONFIG_AHCI=y           # SATA (AHCI) controllers -> /dev/sdX (needs PCI)
CONFIG_IDE=y            # legacy IDE/ATA, PIO -> /dev/hdX (needs PCI)
CONFIG_HDA=y            # Intel HD Audio -> /dev/dsp (OSS-style playback; needs PCI)

# --- networking -------------------------------------------------------------
CONFIG_NET=y            # IPv4 stack, sockets, loopback
CONFIG_E1000=y          # Intel 8254x (e1000) Ethernet (needs PCI, NET)

# --- filesystems (tmpfs is always built: it is the root) --------------------
CONFIG_ZAEFS=y          # sic's own on-disk filesystem
CONFIG_FAT=y            # FAT12/16/32 (read/write, 8.3 + long names read-only)

# --- kernel features --------------------------------------------------------
CONFIG_MODULES=y        # loadable kernel modules (init_module & co.)
CONFIG_SIGNALS=y        # POSIX signals; =n makes kill() ENOSYS and faults fatal
CONFIG_PIPES=y          # pipe2()

# --- debugging --------------------------------------------------------------
CONFIG_SELFTEST=y       # run the boot-time self tests before starting init
